{
  "info": {
    "_postman_id": "2fa50976-51a9-48ba-90ea-dfdf5eff2217",
    "name": "Nextep Bookstore Inventory API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the local development API. Creates a demo book, tests CRUD/filtering/pricing, verifies persistence, and deletes only the created book. Set isbn to an unused valid ISBN. Local currency defaults to EUR; update currency to match LOCAL_CURRENCY. Prices include a 40% markup; fallback rates are clearly marked."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "book_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "isbn",
      "value": "978-84-376-0494-7",
      "type": "string"
    },
    {
      "key": "category",
      "value": "Literatura Clásica",
      "type": "string"
    },
    {
      "key": "currency",
      "value": "EUR",
      "type": "string"
    },
    {
      "key": "calculated_price",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": \"15.99\",\n  \"selling_price_local\": null,\n  \"stock_quantity\": 25,\n  \"category\": \"{{category}}\",\n  \"supplier_country\": \"ES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('book_id', '');",
              "pm.collectionVariables.set('calculated_price', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const book = pm.response.json();",
              "  pm.collectionVariables.set('book_id', String(book.id));",
              "  pm.test('Canonical ISBN', function () { pm.expect(book.isbn).to.eql(pm.variables.get('isbn').replace(/[-\\s]/g, '').toUpperCase()); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List books with pagination",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books?page=1&page_size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Get book by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update book (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": \"15.99\",\n  \"selling_price_local\": null,\n  \"stock_quantity\": 25,\n  \"category\": \"{{category}}\",\n  \"supplier_country\": \"ES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update stock (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock_quantity\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Search by category",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/search?category={{category}}&page_size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Low stock with threshold",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/low-stock?threshold=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Calculate and save selling price",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}/calculate-price",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"target_currency\": \"{{currency}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const quote = pm.response.json();",
              "pm.collectionVariables.set('calculated_price', String(quote.selling_price_local));",
              "pm.test('40 percent markup', function () { pm.expect(quote.margin_percentage).to.eql(40); });",
              "pm.test('Calculation fields', function () { pm.expect(quote).to.include.all.keys('book_id', 'cost_usd', 'exchange_rate', 'cost_local', 'margin_percentage', 'selling_price_local', 'currency', 'calculation_timestamp', 'is_fallback'); });",
              "pm.test('Selling price calculation', function () { const expected = Math.round(Number(quote.cost_usd) * Number(quote.exchange_rate) * 1.4 * 100) / 100; pm.expect(Number(quote.selling_price_local)).to.be.closeTo(expected, 0.01); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Verify saved selling price",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test('Price is persisted', function () { pm.expect(String(pm.response.json().selling_price_local)).to.eql(pm.collectionVariables.get('calculated_price')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Delete demo book",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Deleted book returns 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books/{{book_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Invalid ISBN returns 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"El Quijote\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"9788437604948\",\n  \"cost_usd\": \"15.99\",\n  \"selling_price_local\": null,\n  \"stock_quantity\": 25,\n  \"category\": \"{{category}}\",\n  \"supplier_country\": \"ES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Prefixed list alias",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/inventory/books/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Prefixed API root",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/inventory/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
