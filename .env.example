# Copy this file to .env and replace the placeholder secrets before starting.
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserved for the future exchange-rate integration; not consumed yet.
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_TIMEOUT=10
