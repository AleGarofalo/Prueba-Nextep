# Copy this file to .env and replace the placeholder secrets before starting.
# Compose maps these to PostgreSQL's POSTGRES_* container variables.
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public USD exchange-rate endpoint; no API key is required.
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_API_TIMEOUT=10
EXCHANGE_RATE_CACHE_TTL=3600
EXCHANGE_RATE_FALLBACK_TTL=86400
# Demo defaults from the exam example; the fallback is not a live market quote.
LOCAL_CURRENCY=EUR
EXCHANGE_RATE_DEFAULT_RATE=0.85
